<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07090F">

    <!-- 桌面 WebView（NAS 自带网页桌面） -->
    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 首屏：PC 端登录页（assets/web/login.html，与 PC 仓库同一份文件） -->
    <WebView
        android:id="@+id/loginWeb"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 自绘标题栏（与 PC 端结构一致：左菜单 / 中标题 / 右操作）。
         登录页沿用 PC 的「无标题栏」形态，此栏在登录态下隐藏。 -->
    <LinearLayout
        android:id="@+id/titlebar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@drawable/bg_titlebar"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="菜单"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:tint="#E6EDF3" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="飞牛平板"
            android:textColor="#E6EDF3"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="设置"
            android:src="@android:drawable/ic_menu_preferences"
            android:tint="#E6EDF3" />

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="主页"
            android:src="@android:drawable/ic_menu_view"
            android:tint="#E6EDF3" />

        <ImageButton
            android:id="@+id/btnReload"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="刷新"
            android:src="@android:drawable/ic_menu_rotate"
            android:tint="#E6EDF3" />
    </LinearLayout>
</FrameLayout>
