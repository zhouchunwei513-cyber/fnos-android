<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- v5.1.33（用户任务 1 · 钉到桌面真机根因）：
         MIUI/HyperOS 桌面的 InstallShortcutReceiver 在落快捷键前会校验调用方权限，
         缺权限时只打日志「add shortcut failed, <pkg> has no permission」并静默丢弃，
         表现就是 requestPinShortcut 返回 true 但桌面永远不出图标、也没有 PinIc。
         桌面声明的这两个权限 protectionLevel 都是 normal（dumpsys package com.miui.home
         里的 declared permissions 可见），声明即授予，不需要动态申请。 -->
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />
    <uses-permission android:name="com.miui.home.launcher.permission.UNINSTALL_SHORTCUT" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.FNOS">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.FNOS" />

        <!-- v5.1.30：与 PC 完全一致的偏好设置页（assets/web/settings.html + window.fnosSettings） -->
        <activity
            android:name=".SettingsWebActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.FNOS"
            android:windowSoftInputMode="adjustResize" />

        <!-- v5.1.34（用户 Bug B）：应用宫格唯一入口（设置页里的同一个宫格弹窗，打开即弹出）。
             exported=true：adb / 其它壳可以直接拉起，便于真机验收。 -->
        <activity
            android:name=".AppsActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.FNOS"
            android:windowSoftInputMode="adjustResize" />

        <!-- v5.1.30：与 PC 完全一致的帮助页 / 关于页 -->
        <!-- v5.1.32：帮助页允许外部启动（桌面快捷方式/系统"用其他应用打开"都能拉到帮助），
             内容是本地只读 HTML，无敏感操作 -->
        <activity
            android:name=".HelpActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.FNOS" />

        <activity
            android:name=".AboutActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.FNOS" />

        <!-- 钉到桌面的回执广播（Shortcuts.requestPinShortcut 的第三个参数） -->
        <receiver
            android:name=".PinShortcutReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.fnos.tablet.action.PIN_RESULT" />
            </intent-filter>
        </receiver>

        <!-- 电视直播（v5.1.31-tablet17 真机根因）：
             原来 exported="false" → 启动器（com.miui.home）无权拉起本 Activity，
             MIUI 桌面在落「钉到桌面」时会先 resolve 目标 Intent，解析不到就**静默丢弃**
             （表现：requestPinShortcut 返回 true，但 cmd shortcut 里永远没有 PinIc）。
             另外桌面快捷方式本来就必须跨进程启动它，所以这里必须 exported="true"。
             内容是本地只读 live.html，无敏感操作。 -->
        <activity
            android:name=".LiveActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.FNOS" />

        <activity
            android:name=".AppWindowActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.FNOS"
            android:hardwareAccelerated="true">
            <!-- 桌面快捷方式（动态快捷方式 / 钉到桌面）冷启动直达应用窗：
                 Shortcuts.action.OPEN_APP，extra 带 anchor + base。
                 启动器要能拉起本 Activity，因此必须 exported=true。 -->
            <intent-filter>
                <action android:name="com.fnos.tablet.action.OPEN_APP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
